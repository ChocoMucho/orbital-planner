{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbital Planner",
  "version": "0.1.0",
  "identifier": "com.orbitalplanner.dsp",
  "build": {
    "beforeDevCommand": "pnpm run desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "오비탈 플래너",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["orbital-planner"]
      }
    }
  }
}
